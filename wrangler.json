{
	"compatibility_date": "2025-10-08",
	"main": "src/index.ts",
	"name": "d1-template",
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "010b2320-ad10-4319-9de8-1652891f8d60",
			"database_name": "maxcc_db"
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/*",
			"!/fonts/*",
			"!/katex/*",
			"!/mathlive/*",
			"!/*.js",
			"!/*.css",
			"!/*.png",
			"!/*.svg",
			"!/*.ico",
			"!/*.woff2"
		]
	},
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV"
		}
	],
	"triggers": {
		"crons": [
			"17 19 * * *"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"ratelimits": [
		{
			"name": "RL_LOGIN",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RL_AI",
			"namespace_id": "1002",
			"simple": {
				"limit": 12,
				"period": 60
			}
		},
		{
			"name": "RL_API",
			"namespace_id": "1003",
			"simple": {
				"limit": 150,
				"period": 60
			}
		}
	]
}
